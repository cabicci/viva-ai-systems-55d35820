.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Persona-sim — internal QA only; never deploy to public/
public/persona-sim/
public/lesson-audit/
scripts/persona-sim/output/
# Generated lesson-audit outputs (regenerate via scripts/cross-path-audit.ts)
scripts/lesson-audit/output/
# Local-only P100 persona-sim runners (keep on disk; exclude from git + roadmap:guard)
scripts/persona-sim/run_p100_*.ts
scripts/persona-sim/**/persona-sim-p100-*
scripts/persona-sim/**/*-raw.json
scripts/persona-sim/**/*checkpoint*.json
scripts/persona-sim/**/*.heatmap.csv

# Canonical API audit local reports (regenerate locally; gate recorded in ADAPTIVE_LESSON_ENGINE.md §9f–§9g)
docs/playbooks/adaptive-canonical/reports/*.md
docs/playbooks/adaptive-canonical/reports/*.json
docs/playbooks/adaptive-canonical/reports/.audit.lock

# Python cache
__pycache__/
*.py[cod]

# Controlled-v1 400-visual pipeline: local/CI run outputs (regenerated by
# controlled-visuals:* scripts; CI uploads these as workflow artifacts instead
# of committing them). Keep the directory present via .gitkeep.
artifacts/controlled-v1/cells/
artifacts/controlled-v1/receipts/
artifacts/controlled-v1/provenance/
artifacts/controlled-v1/reports/
artifacts/controlled-v1/contact-sheets/
artifacts/controlled-v1/state/
artifacts/controlled-v1/.method-c-historical-source/
!artifacts/controlled-v1/.gitkeep
