{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-visual-failure/v1",
  "title": "Lesson Visual Cell Failure Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cellId", "runId", "failureCode", "errors", "retryable", "producedAt"],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-failure/v1" },
    "cellId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "failureCode": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "retryable": { "type": "boolean" },
    "producedAt": { "type": "string", "minLength": 1 }
  }
}
