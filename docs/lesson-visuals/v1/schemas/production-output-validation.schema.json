{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-visual-output-validation/v1",
  "title": "Lesson Visual Output Validation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "errors",
    "detectedMime",
    "width",
    "height",
    "byteLength",
    "contentChecksumSha256",
    "fixtureRejected",
    "stubRejected",
    "cellId",
    "sourceSha",
    "approvedManifestSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-output-validation/v1" },
    "ok": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "detectedMime": { "type": ["string", "null"] },
    "width": { "type": ["integer", "null"] },
    "height": { "type": ["integer", "null"] },
    "byteLength": { "type": "integer", "minimum": 0 },
    "contentChecksumSha256": { "type": ["string", "null"] },
    "fixtureRejected": { "type": "boolean" },
    "stubRejected": { "type": "boolean" },
    "cellId": { "type": "string", "minLength": 1 },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
