{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-visual-output-validation/v1",
  "title": "Lesson Visual Output Validation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "errors",
    "detectedMime",
    "width",
    "height",
    "byteLength",
    "contentChecksumSha256",
    "fixtureRejected",
    "stubRejected",
    "cellId",
    "lessonId",
    "locale",
    "runId",
    "controlRoomAuthorizationId",
    "contentSha",
    "executionSha",
    "approvedManifestSha256",
    "providerName",
    "providerAccountId",
    "providerProjectId",
    "providerAuthId",
    "providerRequestId",
    "rightsProvenanceRef",
    "validatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-output-validation/v1" },
    "ok": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "detectedMime": { "type": ["string", "null"] },
    "width": { "type": ["integer", "null"] },
    "height": { "type": ["integer", "null"] },
    "byteLength": { "type": "integer", "minimum": 0 },
    "contentChecksumSha256": { "type": ["string", "null"], "pattern": "^([a-f0-9]{64})?$" },
    "fixtureRejected": { "type": "boolean" },
    "stubRejected": { "type": "boolean" },
    "cellId": { "type": "string", "minLength": 1 },
    "lessonId": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "enum": ["ar-EG", "ar-MSA", "ar-Gulf", "en"] },
    "runId": { "type": "string", "minLength": 1 },
    "controlRoomAuthorizationId": { "type": "string", "minLength": 1 },
    "contentSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "executionSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "providerName": { "type": ["string", "null"] },
    "providerAccountId": { "type": ["string", "null"] },
    "providerProjectId": { "type": ["string", "null"] },
    "providerAuthId": { "type": ["string", "null"] },
    "providerRequestId": { "type": ["string", "null"] },
    "rightsProvenanceRef": { "type": ["string", "null"] },
    "validatedAt": { "type": "string", "minLength": 1 }
  }
}
