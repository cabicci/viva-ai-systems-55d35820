{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-visual-rights/v1",
  "title": "Lesson Visual Rights / Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationMethod",
    "providerOrSource",
    "providerModelOrRenderer",
    "generatedAt",
    "providerRequestId",
    "cellId",
    "sourceSha",
    "approvedManifestSha256",
    "outputContentSha256",
    "sourceReferences",
    "licenseOrUsageBasis",
    "humanReviewRequirement",
    "humanReviewStatus",
    "prohibitedLegacySource",
    "transformationRecord",
    "evidenceReferences",
    "evidenceChecksums"
  ],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-rights/v1" },
    "generationMethod": { "type": "integer", "enum": [1, 2, 3, 4] },
    "providerOrSource": { "type": "string", "minLength": 1 },
    "providerModelOrRenderer": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "providerRequestId": { "type": "string", "minLength": 1 },
    "cellId": { "type": "string", "minLength": 1 },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceReferences": { "type": "array", "items": { "type": "string" } },
    "screenshotSiteIdentity": { "type": ["string", "null"] },
    "licenseOrUsageBasis": { "type": "string", "minLength": 1 },
    "humanReviewRequirement": { "enum": ["required", "not-required"] },
    "humanReviewStatus": { "enum": ["pending", "approved", "rejected", "not-applicable"] },
    "prohibitedLegacySource": { "const": false },
    "transformationRecord": { "type": "array", "items": { "type": "string" } },
    "evidenceReferences": { "type": "array", "items": { "type": "string" } },
    "evidenceChecksums": { "type": "array", "items": { "type": "string" } }
  }
}
