{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-visual-run-summary/v1",
  "title": "Lesson Visual Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "sourceSha",
    "approvedManifestSha256",
    "mode",
    "executionMode",
    "expectedCells",
    "attempted",
    "accepted",
    "skipped",
    "failed",
    "retryable",
    "nonRetryable",
    "totalCostMicros",
    "quotaUsage",
    "quotaCeiling",
    "providerAttemptQuota",
    "providerAttemptsUsed",
    "receiptCount",
    "mappingCount",
    "artifactIndexSha256",
    "finalRunStatus",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-run-summary/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["full", "failed-only"] },
    "executionMode": { "enum": ["production", "dry-run"] },
    "expectedCells": { "type": "integer", "const": 400 },
    "attempted": { "type": "integer", "minimum": 0 },
    "accepted": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "retryable": { "type": "integer", "minimum": 0 },
    "nonRetryable": { "type": "integer", "minimum": 0 },
    "totalCostMicros": { "type": "string", "pattern": "^\\d+$" },
    "quotaUsage": { "type": "integer", "minimum": 0 },
    "quotaCeiling": { "type": "integer", "minimum": 0 },
    "providerAttemptQuota": { "type": "integer", "minimum": 0 },
    "providerAttemptsUsed": { "type": "integer", "minimum": 0 },
    "receiptCount": { "type": "integer", "minimum": 0 },
    "mappingCount": { "type": "integer", "minimum": 0 },
    "artifactIndexSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalRunStatus": { "enum": ["SUCCESS", "FAILED", "PARTIAL"] },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
