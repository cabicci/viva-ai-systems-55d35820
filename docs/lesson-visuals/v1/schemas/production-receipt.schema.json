{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masaarat.local/schemas/lesson-visual-production-receipt/v1",
  "title": "LessonVisualProductionCellReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "runId",
    "controlRoomAuthorizationId",
    "contentSha",
    "executionSha",
    "approvedManifestSha256",
    "cellId",
    "lessonId",
    "locale",
    "method",
    "idempotencyKey",
    "attemptNumber",
    "fingerprint",
    "producedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "lesson-visual-production-receipt/v1" },
    "status": {
      "type": "string",
      "enum": ["ACCEPTED", "FAILED", "SKIPPED", "RETRYABLE_FAILURE", "NON_RETRYABLE_FAILURE"]
    },
    "runId": { "type": "string", "minLength": 1 },
    "controlRoomAuthorizationId": { "type": "string", "minLength": 3 },
    "contentSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "executionSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approvedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cellId": { "type": "string", "minLength": 8 },
    "lessonId": { "type": "string", "minLength": 8 },
    "locale": { "type": "string", "enum": ["ar-EG", "ar-MSA", "ar-Gulf", "en"] },
    "method": { "type": "integer", "enum": [1, 2, 3, 4] },
    "providerName": { "type": ["string", "null"] },
    "providerRequestId": { "type": ["string", "null"] },
    "modelOrRenderer": { "type": ["string", "null"] },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "outputPathOrStorageKey": { "type": ["string", "null"] },
    "mimeType": { "type": ["string", "null"] },
    "width": { "type": ["integer", "null"] },
    "height": { "type": ["integer", "null"] },
    "byteLength": { "type": ["integer", "null"] },
    "contentSha256": { "type": ["string", "null"], "pattern": "^([a-f0-9]{64})?$" },
    "costMicros": { "type": ["string", "null"], "pattern": "^\\d+$" },
    "rightsProvenanceRef": { "type": ["string", "null"] },
    "validationRef": { "type": ["string", "null"] },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "failureCode": { "type": ["string", "null"] },
    "retryable": { "type": ["boolean", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
